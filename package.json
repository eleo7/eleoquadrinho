{
  "name": "eleoquadrinho",
  "version": "2.0.0",
  "description": "Ambiente de Leitura Interativo de Quadrinhos, Mangás e Lore em Português",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "node --check js/app.js && node --check js/dbs-rewards.js && node --check js/reading-rewards.js && node --check js/reward-art.js",
    "deploy": "npx vercel --prod",
    "dev": "npm run build && node --env-file-if-exists=.env.local scripts/dev.js",
    "test": "node --test tests/*.test.js",
    "create-admin": "node --env-file-if-exists=.env.local scripts/create-admin.js",
    "setup-storage": "node --env-file-if-exists=.env.local scripts/setup-storage.js"
  },
  "keywords": [
    "quadrinhos",
    "hqs",
    "mangas",
    "leitor",
    "lore",
    "pwa",
    "eleoquadrinho"
  ],
  "author": "Leo Souza",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "esbuild": "0.25.12",
    "jszip": "^3.10.1",
    "node-unrar-js": "2.0.2"
  }
}
